META_ACCESS_TOKEN=
META_AD_ACCOUNT_IDS=

# Google: share BOTH spreadsheets with the service-account email.
# Paste the complete one-line service-account JSON from Google Cloud here.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Fonte comercial fixa
SALES_SHEET_ID=

# Monthly scheduling/attendance source. Use one variable per month whenever possible.
APPOINTMENT_SHEET_ID_2026_11=
APPOINTMENT_SHEET_ID=

# Optional: revise the operational classification without changing code.
APPOINTMENT_STATUS_KEYWORDS=AGUARDANDO CONFIRMACAO,REMARCACAO,REMARCOU,CHAMADA REALIZADA,ENTRADA - COMPROU,DESISTIU,AGUARDANDO PAGAMENTO
ATTENDANCE_STATUS_KEYWORDS=CHAMADA REALIZADA,ENTRADA - COMPROU,AGUARDANDO PAGAMENTO

# Use "demo" para validar a interface sem conectar nenhuma fonte externa.
DASHBOARD_MODE=demo

